{
  "manifest_version": 3,
  "name": "Klinot COMED Köprüsü",
  "version": "2.8.3",
  "description": "Klinot taslaklarını doğrulanmış POST veya güvenli form doldurma ile COMED test kartına aktarır.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://goztepe.comedtest.mlpcare.com/*",
    "http://goztepe.comedtestapi.mlpcare.com/*",
    "https://doktor-hasta-gorusmesi.onrender.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {"service_worker": "background.js"},
  "action": {
    "default_title": "Klinot COMED Köprüsü",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://goztepe.comedtest.mlpcare.com/tr-tr/medical/*"],
      "js": ["page_trace.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://goztepe.comedtest.mlpcare.com/tr-tr/medical/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
