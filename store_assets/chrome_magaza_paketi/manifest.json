{
  "manifest_version": 3,
  "name": "Klinot",
  "version": "2.39.0",
  "description": "Klinot klinik görüşme taslaklarını hekimin açık hastane bilgi sistemi oturumuna aktarır; kayıt ve imza hekimdedir.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://goztepetest.comed.mlpcare.com/*",
    "https://goztepetestapi.comed.mlpcare.com/*",
    "https://doktor-hasta-gorusmesi.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Klinot",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://doktor-hasta-gorusmesi.onrender.com/*"
      ],
      "js": [
        "doctor_bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://goztepetest.comed.mlpcare.com/tr-tr/medical/*"
      ],
      "js": [
        "page_trace.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://goztepetest.comed.mlpcare.com/tr-tr/medical/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
